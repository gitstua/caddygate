# Required
CADDYGATE_BASE_DOMAIN=apps.example.com
CADDYGATE_DNS_PROVIDER=cloudflare
CADDYGATE_DNS_API_TOKEN=your-cloudflare-api-token-here

# Generate with: python3 -c "import uuid; print(uuid.uuid4())"
CADDYGATE_ENROLLMENT_SECRET=         # keep private — anyone with this URL can enroll their IP

# Optional: pre-seed your own IP so you're not locked out after first boot
# CADDYGATE_INITIAL_CIDRS=203.0.113.42/32,198.51.100.0/24

# Optional: static (non-Docker) services to proxy, comma-separated name=upstream pairs
# Upstream can be a URL (http://host:port) or bare host:port
# CADDYGATE_STATIC_SERVICES=homeassistant=http://192.168.50.193:8123,grafana=http://192.168.50.194:3000

# Optional: trust X-Forwarded-For from these upstream proxy CIDRs (space-separated)
# CADDYGATE_TRUSTED_PROXIES=10.0.0.0/8

# Optional: max enrollment attempts per IP per minute (default: 10)
# CADDYGATE_ENROLL_RATE_LIMIT=10

# Optional: debug, info, warn, error (default: info)
# CADDYGATE_LOG_LEVEL=info

# Optional: sidecar listen address (default: :8081, internal only)
# CADDYGATE_LISTEN_ADDR=:8081

# Optional: Caddy Admin API socket path (default matches caddy.json.tmpl)
# CADDYGATE_ADMIN_SOCKET=/run/caddy/admin.sock
